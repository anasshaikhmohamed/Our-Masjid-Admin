{
  "expo": {
    "name": "Our Masjid DEV",
    "slug": "our-masjid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.ourmasjid.app.dev"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "splash": {
      "backgroundColor": "#EFF7F2"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFF7F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "be433d19-205a-4017-9c26-43d4d936baf7"
      }
    }
  }
}
