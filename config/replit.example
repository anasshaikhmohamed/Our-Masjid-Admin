modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/admin-panel: Admin Panel"

[[workflows.workflow]]
name = "artifacts/admin-panel: Admin Panel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export PORT=5000 BASE_PATH=/admin-panel/ && pnpm --filter @workspace/admin-panel run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

